   int pid = getpid(); // Advertise the parent's pid, not the child's
+#ifdef __APPLE__
+  // macOS has no avahi; publish through Bonjour's dns-sd.
+  // "dns-sd -P" registers the service plus a host record for dns_name -> address,
+  // which covers both avahi-publish-service and avahi-publish-address.
+  if(fork() == 0){
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wunused-result"
+    char *port_string = NULL;
+    asprintf(&port_string, "%d", service_port);
+    char *pid_string = NULL;
+    asprintf(&pid_string, "pid=%d", pid);
+    char hostname[sysconf(_SC_HOST_NAME_MAX)];
+    gethostname(hostname,sizeof(hostname));
+    char *source_string = NULL;
+    asprintf(&source_string, "source=%s", hostname);
+    char *desc_string = NULL;
+    asprintf(&desc_string, "description=%s", description ? description : "");
+#pragma GCC diagnostic pop
+    // dns-sd wants the host without the .local suffix it adds itself
+    char host[256];
+    strlcpy(host, dns_name, sizeof host);
+    char *dot = strstr(host, ".local");
+    if(dot != NULL && dot[6] == '\0')
+      *dot = '\0';
+    if(address != 0){
+      char ip[INET_ADDRSTRLEN];
+      snprintf(ip, sizeof ip, "%d.%d.%d.%d", (address >> 24) & 0xff, (address >> 16) & 0xff, (address >> 8) & 0xff, address & 0xff);
+      execlp("dns-sd", "dns-sd", "-P", service_name, service_type, "local", port_string, host, ip,
+	     desc_string, pid_string, source_string, NULL);
+    } else {
+      execlp("dns-sd", "dns-sd", "-R", service_name, service_type, "local", port_string,
+	     desc_string, pid_string, source_string, NULL);
+    }
+    perror("exec dns-sd failed");
+    _exit(EX_OSERR);
+  }
+  return 0;
+#endif
   if(Static_avahi){
     // Just put in /etc/avahi/services
     avahi_publish_service(service_name, service_type, dns_name,service_port,description,pid);
@@ -61,7 +100,7 @@ int avahi_start(char const *service_name,char const *service_type,int const serv
 #endif
       execlp("avahi-publish-service", "avahi-publish-service", "--no-fail", host_string, service_name, service_type, port_string, description, pid_string, source_string, NULL);
       perror("exec avahi publish service failed");
-      return -1;
+      _exit(EX_OSERR); // never fall back into the parent's code as a second radiod
     }
   }
   if(address != 0){
@@ -85,7 +124,7 @@ int avahi_start(char const *service_name,char const *service_type,int const serv
