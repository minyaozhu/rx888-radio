diff --git a/multicast.c b/multicast.c
index d152539..63e68a5 100644
--- a/multicast.c
+++ b/multicast.c
@@ -24,7 +24,11 @@
 #if defined(linux)
 #include <linux/if_packet.h>
 #include <net/ethernet.h>
+#ifdef __APPLE__
+#include <string.h> // BSD functions are in libc on macOS
+#else
 #include <bsd/string.h>
+#endif
 #include <sys/prctl.h>
 #include <linux/capability.h>
 #endif
@@ -327,6 +331,23 @@ int resolve_mcast(char const *group, void *group_sock, uint16_t default_port, ch
     int const ecode = getaddrinfo(full_host, port, &hints, &results);
     if(ecode == 0)
       break;
+#ifdef __APPLE__
+    // macOS: Bonjour won't resolve the multicast host records radiod publishes.
+    // radiod derives every group address from its name with make_maddr(), so
+    // compute it the same way instead of asking mDNS.
+    size_t const hl = strlen(full_host);
+    if(hl > 6 && strcasecmp(full_host + hl - 6, ".local") == 0){
+      struct sockaddr_in sin = {
+	.sin_len = sizeof(struct sockaddr_in),
+	.sin_family = AF_INET,
+	.sin_port = htons(port != NULL ? (uint16_t)atoi(port) : default_port),
+	.sin_addr.s_addr = htonl(make_maddr(full_host)),
+      };
+      memcpy(group_sock, &sin, sizeof sin);
+      fprintf(stderr, "resolve_mcast: %s not in mDNS, using derived address %s\n", full_host, formatsock(&sin, false));
+      return 0;
+    }
+#endif
     if(!message_logged){
       int64_t now = gps_time_ns();
       if(now > start_time + 2 * BILLION){
@@ -640,12 +661,19 @@ int join_group(int fd, struct sockaddr const * const source, struct sockaddr con
     {
       level = IPPROTO_IP;
       memcpy(&req.gr_group,group,sizeof(struct sockaddr_in));
+#ifdef __APPLE__
+      // BSD kernels reject group_req addresses without sa_len (EINVAL)
+      ((struct sockaddr_in *)&req.gr_group)->sin_len = sizeof(struct sockaddr_in);
+#endif
     }
     break;
   case AF_INET6:
     {
       level = IPPROTO_IPV6;
       memcpy(&req.gr_group,group,sizeof(struct sockaddr_in6));
+#ifdef __APPLE__
+      ((struct sockaddr_in6 *)&req.gr_group)->sin6_len = sizeof(struct sockaddr_in6);
+#endif
     }
     break;
   default:
