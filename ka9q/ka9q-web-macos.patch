--- a/Makefile
+++ b/Makefile
@@ -10,6 +10,14 @@ COPTS=-march=native -std=gnu11 -pthread -Wall -funsafe-math-optimizations -D_GNU
 
 KA9QOBJS = misc.o multicast.o rtp.o status.o decode_status.o
 INCLUDES=
+LIBS=-lonion -lbsd -lm -ldl
+
+ifeq ($(shell uname -s),Darwin)
+	# macOS: strlcpy is in libc (no libbsd); Onion may be a local install (ONION=prefix)
+	ONION ?= /opt/homebrew
+	INCLUDES += -I$(ONION)/include -I/opt/homebrew/include
+	LIBS = -L$(ONION)/lib -Wl,-rpath,$(ONION)/lib -lonion -lm
+endif
 
 RESOURCES_BASE_DIR=$(PREFIX)/share/ka9q-web
 
@@ -23,7 +31,7 @@ KA9Q_RADIO_OBJS=$(KA9QOBJS)
 all: ka9q-web
 
 ka9q-web: ka9q-web.o $(KA9Q_RADIO_OBJS)
-	$(CC) -o $@ $^ -lonion -lbsd -lm -ldl
+	$(CC) -o $@ $^ $(LIBS)
 
 # Generate config paths header (copied from ka9q-web1 Makefile)
 esc = sed 's/\\/\\\\/g; s/"/\\"/g'
